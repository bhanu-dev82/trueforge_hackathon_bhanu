{
  "name": "trueforge-ci-failure-surgeon",
  "version": "1.0.0",
  "description": "TrueForge agent that reproduces a CI failure in a sandbox, drafts a patch, and pauses for approval",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "demo": "tsx src/backend.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:fixture": "node --test fixture/auth-service/tests/token_verifier.test.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "keywords": [
    "trueforge",
    "agent-harness",
    "mcp",
    "daytona",
    "qodo",
    "gemini"
  ],
  "author": "Bhanu Nagpure",
  "license": "MIT",
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
