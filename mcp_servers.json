{
  "description": "Connectors this agent expects in TrueForge Settings → Connectors. Names must match the TrueForge catalog (`exa`, `github`). npm run demo upserts these when keys are present.",
  "mcpServers": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "description": "Web search and page fetch"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": {
        "type": "header",
        "headers": {
          "Authorization": "Bearer ${GITHUB_TOKEN}"
        }
      },
      "description": "Optional PR creation after approval"
    }
  }
}
