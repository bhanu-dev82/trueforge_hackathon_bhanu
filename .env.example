# TrueForge (local standalone has no login; omit the token)
TRUEFORGE_API_URL=http://localhost:8790
TRUEFORGE_API_TOKEN=

# Google AI Studio — used to upsert Settings → Models
GEMINI_API_KEY=

# Bare ids are prefixed to google-gemini/<id>
MODEL_NAME=gemini-3.1-flash-lite
# Low-RPD model; only used when the task is marked deep
MODEL_DEEP=gemini-3.7-flash
# High RPD first. 3.7-flash is 20 RPD — keep it in MODEL_DEEP only.
# gemma-4-26b is 14.4k RPD / 16k TPM — last-resort safety net.
MODEL_FAILOVER_CHAIN=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-26b

# Exa MCP (web search). Optional header auth if your Exa project requires it.
EXA_API_KEY=

# Optional. Demo works without this; PR opening is skipped.
GITHUB_TOKEN=

# Optional Daytona key — TrueForge Settings → Sandbox, not the agent spec.
DAYTONA_API_KEY=
BUDGET_TOKENS_PER_RUN=120000

TEAM_NAME=agent-i
DEMO_PORT=8787

# Never enable for the judge demo — it skips the approval gate.
DEMO_AUTO_APPROVE=false
